{
  "author": "igorlogius",
  "browser_specific_settings": {
    "gecko": {
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "homepage_url": "https://github.com/igorlogius/webextensions/tree/main/sources/select-tabs-ext",
  "description": "Powerful tab selection addon",
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_area": "navbar",
    "default_title": "Select Tabs"
  },
  "commands": {
    "All": {},
    "Invert": {},
    "Same Container": {},
    "Same Group": {},
    "Bookmarked": {},
    "Descendents": {},
    "Siblings": {},
    "Children": {},
    "Parent": {},
    "Ancestors": {},
    "Same URL": {},
    "Same Origin": {},
    "Same Domain": {},
    "Same Port": {},
    "Same Protocol": {},
    "To the Left": {},
    "To the Right": {},
    "Pinned": {},
    "Muted": {},
    "Loading": {},
    "Complete": {},
    "Audible": {},
    "Auto Discardable": {},
    "UserScripts": {},
    "Open Selector": {}
  },
  "icons": {
    "512": "icon.png"
  },
  "manifest_version": 2,
  "name": "Select Tabs Ext",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "tabs",
    "bookmarks",
    "notifications",
    "<all_urls>"
  ],
  "version": "1.11.0"
}

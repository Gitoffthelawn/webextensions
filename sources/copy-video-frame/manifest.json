{
  "author": "igorlogius",
  "browser_specific_settings": {
    "gecko": {
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "commands": {
    "copy-video-frame": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Capture the video under the mouse (or the first playing video)"
    }
  },
  "homepage_url": "https://github.com/igorlogius/webextensions/tree/main/sources/copy-video-frame",
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_area": "navbar",
    "default_icon": "icon.png",
    "default_title": "Copy Video Frame — capture the first visible video"
  },
  "description": "Adds a context menu entry that allows to capture a still frame image from a html video element",
  "icons": {
    "512": "icon.png"
  },
  "manifest_version": 2,
  "name": "Copy Video Frame",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": ["menus", "activeTab", "storage"],
  "optional_permissions": ["clipboardWrite"],
  "version": "1.1.13"
}

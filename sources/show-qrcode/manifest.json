{
  "author": "igorlogius",
  "browser_specific_settings": {
    "gecko": {
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "homepage_url": "https://github.com/igorlogius/webextensions/tree/main/sources/show-qrcode",
  "background": {
    "scripts": ["background.js"]
  },
  "commands": {
    "_execute_browser_action": {}
  },
  "description": "Show quick response codes for any tab url, any selected link, text or bookmark",
  "icons": {
    "15": "icon.png"
  },
  "manifest_version": 2,
  "name": "Show QRcode",
  "browser_action": {
    "default_area": "navbar",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "view.html",
    "open_in_tab": true
  },
  "permissions": ["activeTab", "tabs", "storage", "menus", "clipboardWrite"],
  "optional_permissions": ["bookmarks"],
  "version": "1.8.36"
}

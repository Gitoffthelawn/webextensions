{
  "author": "igorlogius",
  "browser_specific_settings": {
    "gecko": {
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "homepage_url": "https://github.com/igorlogius/webextensions/tree/main/sources/automate-click",
  "description": "automate some click actions when visiting a website",
  "browser_action": {
    "default_area": "navbar",
    "default_title": "Automate Click (click to add a rule for this page)"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "world": "MAIN",
      "run_at": "document_start",
      "match_about_blank": true,
      "all_frames": true,
      "js": ["start.js"],
      "matches": ["<all_urls>"]
    },
    {
      "run_at": "document_idle",
      "match_about_blank": true,
      "all_frames": true,
      "js": ["content-script.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "128": "icon.png"
  },
  "manifest_version": 2,
  "name": "Automate Click",
  "options_ui": {
    "open_in_tab": true,
    "page": "options.html"
  },
  "permissions": [
    "webNavigation",
    "activeTab",
    "storage",
    "tabs",
    "<all_urls>"
  ],
  "version": "1.15.0"
}

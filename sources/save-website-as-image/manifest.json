{
  "author": "igorlogius",
  "background": {
    "scripts": ["jszip.js", "shared.js", "background.js"]
  },
  "browser_action": {
    "default_area": "navbar"
  },
  "browser_specific_settings": {
    "gecko": {
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "commands": {
    "_execute_browser_action": {}
  },
  "description": "Make full website snapshots",
  "homepage_url": "https://github.com/igorlogius/webextensions/tree/main/sources/save-website-as-image",
  "icons": {
    "128": "icon.png"
  },
  "manifest_version": 2,
  "name": "Save Website as Image",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": ["activeTab", "<all_urls>", "downloads", "storage"],
  "version": "1.5.0"
}

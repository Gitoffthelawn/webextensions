{
  "author": "igorlogius",
  "homepage_url": "https://github.com/igorlogius/webextensions/tree/main/group-same-site-tabs",
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_title": "Group All Tabs by Site",
    "default_area": "navbar",
    "default_icon": "icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "commands": {
    "group-selected": {
      "description": "Group Selected Sites"
    },
    "group-all": {
      "description": "Group All Sites"
    },
    "group-selected-uncollapsed": {
      "description": "Group Selected Sites (uncollapsed)"
    },
    "group-all-uncollapsed": {
      "description": "Group All Sites (uncollapsed)"
    }
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "description": "Move same site/domain tabs into named collapsed or uncollapsed native tabgroups",
  "manifest_version": 2,
  "name": "Group Same Site Tabs",
  "options_ui": {
    "page": "options.html"
  },
  "permissions": ["tabs", "menus", "tabGroups", "storage"],
  "version": "1.0.0"
}

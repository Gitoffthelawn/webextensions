{
  "author": "igorlogius",
  "browser_specific_settings": {
    "gecko_android": {
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko": {
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "homepage_url": "https://github.com/igorlogius/webextensions/tree/main/sources/dont-load-background-tabs",
  "description": "Prevents background tabs from loading until activated",
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_area": "navbar",
    "default_icon": "icon.svg"
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg",
    "128": "icon.svg"
  },
  "manifest_version": 2,
  "name": "Dont Load Background Tabs",
  "options_ui": {
    "page": "options.html"
  },
  "permissions": ["storage", "webRequest", "webRequestBlocking", "<all_urls>"],
  "version": "1.3.20"
}

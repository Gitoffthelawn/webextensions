{
  "author": "igorlogius",
  "browser_specific_settings": {
    "gecko": {
      "strict_min_version": "139.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "homepage_url": "https://github.com/igorlogius/webextensions/tree/main/sources/open-bookmarks-in-tabgroup",
  "background": {
    "scripts": ["background.js"]
  },
  "icons": {
    "256": "icon.png"
  },
  "description": "Open a bookmark folder as a tabgroup",
  "manifest_version": 2,
  "name": "Open Bookmarks in Tabgroup",
  "options_ui": {
    "page": "options.html",
    "browser_style": false
  },
  "permissions": ["bookmarks", "menus", "storage", "tabGroups", "tabs"],
  "version": "1.3.1"
}
